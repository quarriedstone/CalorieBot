# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Ключ DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательные настройки (значения по умолчанию уже указаны)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DB_PATH=data/bot.db

# Telegram ID администраторов через запятую (доступ к /grant и /revoke)
ADMIN_IDS=

# Подписка: Telegram Stars (XTR), 150 звёзд за 30 дней
PAYMENTS_PRICE=150
PAYMENTS_DAYS=30
PAYMENTS_GRANT_DAYS=3650
PAYMENTS_FREE_NOTES=3
PAYMENTS_FREE_MEALS=10
